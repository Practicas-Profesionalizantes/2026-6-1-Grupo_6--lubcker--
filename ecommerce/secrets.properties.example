# Copiar como "secrets.properties" (en esta misma carpeta) y completar.
# "secrets.properties" NO se sube a GitHub; este archivo de ejemplo SI.
#
# Clave de la API de Gemini para el asistente de chat (Lubcki).
# Se crea en https://aistudio.google.com/apikey
# Sin clave el resto de la tienda funciona igual; el chat avisa que no esta disponible.
app.chat.api-key=COMPLETAR

# Access Token de Mercado Pago (Checkout Pro). Para pruebas usar el de "Credenciales de prueba".
# Se obtiene en https://www.mercadopago.com.ar/developers/panel > tu aplicacion.
# Sin token la tienda funciona, pero no se puede finalizar una compra.
app.mercadopago.access-token=COMPLETAR
