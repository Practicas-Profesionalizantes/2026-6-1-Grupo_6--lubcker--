# Copiar como ".env.local" para desarrollo, o cargar en Vercel (Settings > Environment Variables).
#
# Dirección del backend, con "/api" al final y sin barra final.
# Sin esta variable se usa http://localhost:8080/api (desarrollo local).
# OJO: se incorpora al compilar; si la cambiás en Vercel hay que volver a desplegar.
REACT_APP_API_URL=https://tu-backend.ejemplo.com/api
